{
    "name": "switon/yaml",
    "description": "Strict Switon YAML subset read/write with placeholder interpolation for Switon Framework",
    "type": "library",
    "keywords": [
        "switon",
        "yaml",
        "parser",
        "writer",
        "config"
    ],
    "homepage": "https://github.com/switon-php/yaml",
    "license": "MIT",
    "authors": [
        {
            "name": "switon",
            "email": "admin@switon.dev"
        }
    ],
    "support": {
        "source": "https://github.com/switon-php/yaml",
        "issues": "https://github.com/switon-php/yaml/issues",
        "docs": "https://github.com/switon-php/yaml/blob/main/docs/README.md"
    },
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "switon/core": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "switon/testing": "^1.0",
        "phpunit/phpunit": "^12.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "switon/composer-extra": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Switon\\Yaml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Switon\\Yaml\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse",
        "test": "@php vendor/bin/phpunit --configuration tests/phpunit.xml.dist --testsuite=all --display-deprecations --display-phpunit-notices"
    },
    "extra": {
        "switon": {
            "providers": []
        },
        "branch-alias": {
            "dev-dev": "1.0.x-dev"
        }
    }
}
